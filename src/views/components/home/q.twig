<div
  class="s-block s-block--faqs no-home-tab has-bg angel_anime animate__ animate__fadeIn"
>
  <h2
    class="text-center text-2xl font-bold text-white mb-8 pb-4"
  >
    {{ component.htitle }}
  </h2>

  <div class="faqs-list grid items-start grid-cols-1 md:grid-cols-2 gap-4 max-w-screen-md  mx-auto">
    {# min-w-72 (288px) for mobile, full width for desktop #} {% for item in
    component.q %}
    <div class="w-full">
      {# Title as Toggle Button #}
      <button
        class="w-full flex justify-between items-center text-base font-medium text-gray-100 bg-[#252C46] p-4 rounded-lg hover:bg-[#2C345E] transition-all duration-300 shadow-md hover:shadow-lg group"
        onclick="toggleDescription('desc-{{ loop.index }}', 'icon-{{ loop.index }}')"
      >
        <span>{{ item.title }}</span>
        <svg
          id="icon-{{ loop.index }}"
          class="w-5 h-5 transform transition-transform duration-300"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 9l-7 7-7-7"
          />
        </svg>
      </button>

      {# Description Panel #}
      <div
        id="desc-{{ loop.index }}"
        class="mt-2 hidden overflow-hidden transition-all duration-500 ease-in-out max-h-0"
      >
        <div
          class="p-4 bg-[#1E2338] rounded-lg text-gray-300 text-base leading-relaxed"
        >
          {{ item.desc }}
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

<script>
  window.toggleDescription = function (descId, iconId) {
    const descElement = document.getElementById(descId);
    const iconElement = document.getElementById(iconId);

    if (descElement.classList.contains("hidden")) {
      // Open panel
      descElement.classList.remove("hidden");
      setTimeout(() => {
        descElement.style.maxHeight = descElement.scrollHeight + "px";
        iconElement.style.transform = "rotate(180deg)";
      }, 10);
    } else {
      // Close panel
      descElement.style.maxHeight = "0";
      iconElement.style.transform = "rotate(0deg)";
      setTimeout(() => {
        descElement.classList.add("hidden");
      }, 500);
    }
  };

  // Add smooth scroll into view for opened panels
  document.addEventListener("click", function (e) {
    if (e.target.closest("button")) {
      const panel = e.target.closest("button").nextElementSibling;
      if (!panel.classList.contains("hidden")) {
        setTimeout(() => {
          panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }, 300);
      }
    }
  });
</script>
