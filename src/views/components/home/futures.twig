<div class="bg-[#2C345E] py-10 px-4 md:px-20 rounded-md my-8"> 
    <div class="container mx-auto">
  
      <!-- Title Section -->
      <div class=" flex flex-col gap-2 justify-center items-center my-4 text-center">
        <p class=" text-primary text-xl md:text-2xl font-bold">{{ component.title }}</p>
        <p class="text-gray-400 text-md md:text-lg">{{ component.subtitle }}</p>
      </div>
  
      <!-- Features Section -->
      <div class="flex flex-wrap gap-6 justify-around items-center md:scale-100">
        {% for item in component.futures %}
        <div class="w-max flex flex-col items-center text-center p-4 transition-transform transform hover:scale-105">
          <!-- Image -->
          <img src="{{ item.image }}" alt="{{ item.title }}" class="flex-center h-16     w-16 md:h-20 md:w-20">
          <!-- Title and Subtitle -->
          <p class="text-white  font-semibold">{{ item.title }}</p>
          <p class="text-gray-400 text-sm">{{ item.stitle }}</p>
        </div>
        {% endfor %}

      </div>
  
    </div>
  </div>
  