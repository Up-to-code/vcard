<div class="bg-dark py-8 px-4 my-8">
    <div class="container mx-auto">
  
      <!-- Title Section -->
      <div class="futures-title flex flex-col gap-2 justify-center items-center my-6 text-center">
        <p class="text-white text-2xl font-bold">{{ component.title }}</p>
        <p class="text-gray-300 text-lg">{{ component.subtitle }}</p>
      </div>
  
      <!-- Features Section -->
      <div class="flex flex-wrap gap-4 justify-center items-center scale-x-90 md:scale-100">
        {% for item in component.futures %}
        <div class="w-max flex flex-col items-center text-center p-4 animate">
          <!-- Image -->
          <img src="{{ item.image }}" alt="{{ item.title }}" class="w-14 h-14 rounded-full mb-2">
          <!-- Title and Subtitle -->
          <p class="text-white text-lg font-bold">{{ item.title }}</p>
          <p class="text-gray-300 text-sm">{{ item.subtitle }}</p>
        </div>
        {% endfor %}
      </div>
  
    </div>
  </div>
  