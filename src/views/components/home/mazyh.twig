<section
  class="s-block s-block--features angel-features dark py-8 angel_anime animate__animate__fadeIn"
  data-wow-delay="0.1s"
  style="
    background-color: rgb(20, 22, 31);
    visibility: visible;
    animation-delay: 0.1s;
  "
>
  <div class="container">
    <div class="grid grid-cols-3 items-baseline gap-2 sm:gap-6 lg:gap-4">
      {% for item in component.mazyh %}
      <div class="angel-feature flex-center flex-col" data-wow-delay="0.1s">
        <div class="flex-center h-14 w-14 md:h-20 md:w-20">
          <!-- Icon or Image -->
          <img class=" h-10 w-10 md:h-20 md:w-20 object-contain" src="{{ item.icone }}" alt="{{ item.title }}" />
        </div>
        <div class="flex-center flex-col mt-2">
          <h4 class="text-center text-base md:text-lg text-white font-semibold">{{ item.title }}</h4>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
