<section
  class="s-block s-angel--divider is_flying angel_anime animate__ animate__fadeIn merge-bottom centered-title mb-1"
  data-wow-delay="0.1s"
  style="visibility: visible; animation-delay: 0.1s;"
>
 
  <div class="divider-container container">
    <div class="s-block__title divider-title">
      <div class="flex flex-col w-full">
        <div class="flex-center w-full gap-2">
          <span class="inline-block vertical-lines h-[1px] w-full bg-gray-300 da-bgg angel_anime animate__ animate__fadeInRight" data-wow-delay="0.8s" style="visibility: visible; animation-delay: 0.8s;"></span>
          <!-- Icon, title, and countdown -->
          <div class="flex-center flex-col px-4 md:px-10 z-1 gap-1 md:gap-2">


            <div class="divider-icon">
              <div class="img-container flex flying-obj spinning-obj">
                <img
                  src="{{component.image}}"
                  alt="Icon"
                  class="w-full h-full object-contain lazy max-h-12 angel_anime animate__ animate__fadeIn mb-2 animate-bounce"
                  data-wow-delay="0.5s"
                  loading="lazy"
                  style="visibility: visible; animation-delay: 0.5s;"
                />
              </div>
            </div>

            <!-- Title and description -->
            <div class="flex flex-col items-center justify-center text-center  w-max">
              <h2
                class="w-full px-1 da-cp whitespace-nowrap angel_anime animate__ animate__fadeIn text-primary mb-1  font-extrabold"
                data-wow-delay="0.1s"
                style="visibility: visible; animation-delay: 0.1s;"
              >
                {{component.title}}
              </h2>
              <p
                class="text-center text-sm md:text-lg text-white mb-1 w-max"
                data-wow-delay="0.2s"
                style="visibility: visible; animation-delay: 0.2s;"
              >
                {{component.title_2}}
              </p>
            </div>

            <!-- Red box section -->
            <div class="  text-white font-bold px-2  pb-2 p-1 bg-red-500 mt-1">
              <p>
                {{component.redbox}}
              </p>
            </div>
            <!-- 'More' Link -->
            <a
              href="{{component.more_url}}"
              class="s-block__display-all flex-center divider-url angel_anime animate__ animate__fadeIn text-zinc-100 mb-1 rounded-full px-4 py-2  mt-1 transition duration-300"
              data-wow-delay="0.3s"
              aria-label="Explore More"
              style="visibility: visible; animation-delay: 0.3s;"
            >
              عرض المزيد
            </a>
          </div>
 
          <span class="inline-block vertical-lines h-[1px] w-full bg-gray-300 da-bgg angel_anime animate__ animate__fadeInRight" data-wow-delay="0.8s" style="visibility: visible; animation-delay: 0.8s;"></span>

        </div>
      </div>
    </div>

 </section>
