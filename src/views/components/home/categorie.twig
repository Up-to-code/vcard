{% for item in component.categorie %}
     <div class="flex flex-col items-center justify-center w-full h-full">
        <img src="{{ item.image }}" alt="{{ item.name }}" class="w-full h-full object-cover">
        <p>
         <a href="{{ item.url }}" class="text-center text-white text-2xl font-bold hover:text-primary transition-all duration-300">
           {{ item.name }}
         </a>
       </p>
     </div>
{% endfor %}