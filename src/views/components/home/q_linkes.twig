<div class="q_linkes">
  <div class="q_linkes__title">
    <h2 class="text-primary text-center">
      {{ component.title }}
    </h2>
    <salla-slider class="q_linkes__slider">
      <div class="item">
        {% for item in component.links %}
        <div class=" bg to-darker py-2 px-4 text-center  h-20 w-20"> 
          <img src="{{item.image}}" alt="{{item.title}}" class=" w-10 object-cover rounded-full" />
          <h3 class="text-white hover:text-primary text-center">{{item.title}}</h3>
        </div>

        {% endfor %}
      </div>
    </salla-slider>
  </div>
</div>
