<div class="q_linkes py-16  container">
    <div class="q_linkes__title">
      <h2 class="text-primary text-center font-bold text-4xl mb-12">
        {{ component.title }}
      </h2>
      <salla-slider class="q_linkes__slider flex justify-center space-x-8">
        <div class="item flex space-x-8">
          {% for item in component.links %}
          <a href="{{ item.url }}" class="relative text-center bg-[#252C46]   p-6 rounded-lg shadow-lg transform transition duration-300 ease-in-out hover:bg-primary   hover:shadow-2xl   fade-in" aria-label="{{ item.title }}">
            <img src="{{ item.image }}" alt="{{ item.title }}" class="w-20 h-20 rounded-full object-cover border-2 border-white shadow-md transition-transform duration-300 ease-in-out hover:scale-110">
            <h4 class="leading-none text-white text-base font-semibold mt-4 transition-colors duration-300">{{ item.title }}</h4>
          </a>
          {% endfor %}
        </div>
      </salla-slider>
    </div>
  </div>
  