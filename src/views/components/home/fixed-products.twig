<section class="px-4">
  <div class="s-block__title">
    <div class="right-side">
      <h2 class="text-white">{{ title }}</h2>
    </div>
    
    {% if display_all_url %}
      <a href="{{ display_all_url }}" class="s-block__display-all">
        {{ trans("blocks.home.display_all") }} 
        <i class="sicon-arrow-left"></i>
      </a>
    {% endif %}
  </div>

  <div class="flex flex-wrap gap-4">
    {% for product in products %}
      <a href="{{ product.url }}">
        <div class="product-card max-w-[220px] w-max rounded-lg bg-[#252C46] pb-2 relative shadow-lg hover:shadow-xl transition-transform duration-300 ease-in-out">
          
          <!-- Sale Badge -->
          {% if product.promotion_title|length > 0 %}
            <div class="absolute z-10 top-2 right-2 bg-red-500 text-white text-xs px-3 py-1 rounded-md animate-pulse">
              {{ product.promotion_title   }}
            </div>
          {% endif %}
          
          <!-- Product Image -->
          <div class="block relative overflow-hidden group rounded-md">
            <img src="{{ product.image.url }}" alt="{{ product.image.alt }}" class="w-full min-w-[200px] max-h-[200px] object-cover mb-3 transition-transform duration-300 rounded-md" />
          </div>

          <!-- Product Name -->
          <p class="text-white text-sm md:text-base text-center leading-tight mb-2 px-2 line-clamp-2">
            {{ product.name }}
          </p>

          <!-- Subtitle (if exists) -->
          {% if product.subtitle %}
            <div class="flex justify-center mb-2">
              <p class="text-gray-400 text-sm">{{ product.subtitle }}</p>
            </div>
          {% endif %}

          <!-- Price Section -->
          <div class="flex  justify-center items-center gap-1 mb-4">
            {% if product.regular_price|money != product.sale_price|money %}
              <!-- New Price (Sale Price) -->
              <span class="text-teal-300 text-base font-bold">{{ product.sale_price | money }}</span>
              <!-- Old Price (Regular Price) -->
              <span class="text-gray-400 text-sm line-through">{{ product.regular_price | money }}</span>
            {% else %}
              <!-- Regular Price (No Sale) -->
              <span class="text-teal-300 text-base font-bold">{{ product.price | money }}</span>
            {% endif %}
          </div>

          <!-- Add to Cart / Wishlist -->
          <div class="flex justify-between items-center px-2 z-10">
            <salla-add-product-button product-id="{{ product.id }}">
              <div class="flex items-center gap-2">
                <span>أضف للسلة</span>
                <svg class="w-4 h-4 transition-transform duration-300 hover:rotate-12 hover:scale-110" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M6 6h15l-1.5 9h-13L3 3H1"></path>
                  <circle cx="9" cy="21" r="1"></circle>
                  <circle cx="20" cy="21" r="1"></circle>
                </svg>
              </div>
            </salla-add-product-button>
            
            <button class="text-gray-400 hover:text-red-500 transition-transform duration-200" @click="addToWishlist({{ product.id }})">
              <i class="sicon-heart text-xl"></i>
            </button>

          </div>
        </div>
      </a>
    {% endfor %}
  </div>
</section>
