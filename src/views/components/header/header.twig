<header class="store-header">
  {# Main Nav #}
  <div
    id="mainnav"
    class="main-nav-container shadow-default bg-[#1a1f32] text-white"
  >
    <div class="inner bg-inherit">
      <div class="container">
        <div class="flex items-center justify-between relative">
          
          {# Left Section: Mobile Menu Icon and Custom Menu #}
          <div class="flex items-center">
            <a
              class="lg:hidden mburger mburger--collapse leading-none rtl:ml-4 ltr:mr-4"
              href="#mobile-menu"
              aria-label="Open-menu"
            >
              <i class="sicon-menu text-primary text-2xl"></i>
            </a>
            
            {# Custom Main Menu (Hidden on small screens) #}
            <custom-main-menu class="hidden lg:block"></custom-main-menu>
          </div>

          {# Center Section: Store Logo (Centered) #}
          <div
            class="absolute inset-x-0 mx-auto flex justify-center items-center"
          >
            <a class="navbar-brand" href="{{ store.url }}">
              <img
                fetchpriority="high"
                width="100%"
                height="100%"
                loading="eager"
                src="{{ store.logo }}"
                alt="{{ store.name }} logo"
                class="h-12 w-auto"
              />
              {% if is_page('index') %}
              <h1 class="sr-only">{{ store.name }}</h1>
              {% else %}
              <h2 class="sr-only">{{ store.name }}</h2>
              {% endif %}
            </a>
          </div>

          {# Right Section: User Menu and Cart Summary #}
          <div class="flex items-center justify-end gap-6">
            
            {# User Menu Icon or Login Button #}
            {% if user.type == 'user' %}
            <salla-user-menu avatar-only show-header></salla-user-menu>
            {% else %}
            <button
              class="header-btn"
              aria-label="user-icon"
              onclick="salla.event.dispatch('login::open')"
            >
              <i class="header-btn__icon sicon-user-circle text-2xl"></i>
            </button>
            {% endif %}

            {# Cart Summary Icon #}
            <div class="relative flex items-center justify-center px-4">
              <a href="{{ store.url }}/cart" class="s-cart-summary">
              <i class="sicon-cart2 text-2xl"></i>
              <span class="absolute -top-2 right-[6px] bg-primary text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">
                {{ cart.items_count }}
              </span>
            </a>
            <div>
              {{ cart.total }}
            </div>
            
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
